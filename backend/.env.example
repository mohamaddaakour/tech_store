DB_URL=jdbc:postgresql://localhost:port_number/database_name
DB_USERNAME=database_username
DB_PASSWORD=database_password
SERVER_PORT=8080

# Used by the postgres container in docker-compose.yml (must match DB_* above)
POSTGRES_DB=database_name
POSTGRES_USER=database_username
POSTGRES_PASSWORD=database_password

# Secret used to sign JWTs (Phase 3). Must be at least 32 characters -- the app refuses to
# start with anything shorter, because HMAC-SHA256 requires a 256-bit key.
#
# Generate a strong one:
#   PowerShell -> [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#   Bash       -> openssl rand -base64 48
#
# Changing this value invalidates every token already issued, logging everyone out.
JWT_SECRET=replace_me_with_at_least_32_random_characters
